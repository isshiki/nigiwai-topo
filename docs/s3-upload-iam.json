{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::remasahiko",
      "Condition": {"StringLike": {"s3:prefix": ["nigiwai-topo/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::remasahiko/nigiwai-topo/*"
    }
  ]
}
